# Copy to .env and fill in real values. Never commit .env.
RAG_MYSQL_HOST=127.0.0.1
RAG_MYSQL_PORT=3307
RAG_MYSQL_USER=rag
RAG_MYSQL_DATABASE=praxis_rag
RAG_MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# 32-byte base64 key, for example:
# python -c "import base64,secrets;print('base64:'+base64.b64encode(secrets.token_bytes(32)).decode())"
RAG_STATE_ENCRYPTION_KEY=base64:replace-with-32-byte-key

# The state layer is MySQL-only; there is no local file fallback. The Go test
# suite runs against a disposable schema whose name must contain "test":
#   CREATE DATABASE praxis_unit_test CHARACTER SET utf8mb4 COLLATE utf8mb4_bin;
#   GRANT ALL ON praxis_unit_test.* TO 'rag'@'%';
RAG_TEST_MYSQL_URL=mysql+pymysql://rag:change-me@127.0.0.1:3307/praxis_unit_test?charset=utf8mb4

QDRANT_URL=http://127.0.0.1:6333

# Redis is OPTIONAL: it only backs the persistent MySQL read-model display cache
# (the cache worker rebuilds it; MySQL stays the source of truth). MCP/REST search
# is synchronous and does not need Redis or Kafka; Kafka is required for async
# document ingestion (rag-document-worker consumes RAG_DOCUMENT_TOPIC).
RAG_REDIS_URL=redis://127.0.0.1:6379/0
RAG_REDIS_PREFIX=rag:state:v1
RAG_REDIS_TTL_SECONDS=60
RAG_REDIS_TIMEOUT_SECONDS=0.3

# --- Kafka (replaces RocketMQ) ---------------------------------------------
# Host processes (rag-service, workers, start-stack) use 127.0.0.1:9092.
# Containers on the compose network use kafka:9092 (compose app/worker/connect
# set RAG_APP_KAFKA_BOOTSTRAP_SERVERS themselves; do not put kafka:9092 here).
# Comma-separated list supported for a real multi-broker cluster.
RAG_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
RAG_KAFKA_CLIENT_ID=praxis-rag
# PLAINTEXT | SSL | SASL_PLAINTEXT | SASL_SSL
RAG_KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# PLAIN | SCRAM-SHA-256 | SCRAM-SHA-512 (only for SASL_* protocols)
RAG_KAFKA_SASL_MECHANISM=
RAG_KAFKA_SASL_USERNAME=
RAG_KAFKA_SASL_PASSWORD=
# Optional PEM CA file and TLS verification switch for SSL/SASL_SSL.
RAG_KAFKA_TLS_CA=
RAG_KAFKA_TLS_INSECURE=false
RAG_KAFKA_PUBLISH_TIMEOUT_SECONDS=10
# Optional host port mapping for the single-node compose broker (default 9092).
# RAG_KAFKA_HOST_PORT=9092
# Compose app/worker/connect container bootstrap override (default kafka:9092).
# RAG_APP_KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Topic/group names. Kafka allows dots in topic names; these are kept stable
# across the RocketMQ -> Kafka migration so existing operational docs still apply.
RAG_CACHE_TOPIC=praxis_state_cache_refresh
RAG_CACHE_GROUP=praxis_state_cache_refresh_workers
RAG_DOCUMENT_TOPIC=praxis_document_ingest
RAG_DOCUMENT_GROUP=praxis_document_ingest_workers
# Worker retries happen IN-PROCESS; after the attempt limit the raw message is
# published to the matching DLQ topic and the source offset is committed. The
# dead-letter worker consumes the DLQ topic with the separate *DLQ_GROUP* and
# records the durable terminal state (document_jobs failed). Search never enters
# this pipeline: MCP/REST search is synchronous.
RAG_DOCUMENT_DLQ_TOPIC=praxis_document_ingest_dead_letters
# Malformed cache CDC events are dead-lettered here instead of blocking the cache
# topic; the cache worker never retries an unparsable locator record forever.
RAG_CACHE_DLQ_TOPIC=praxis_state_cache_refresh_dead_letters
RAG_DOCUMENT_DLQ_GROUP=praxis_document_dead_letters
RAG_CACHE_DLQ_GROUP=praxis_state_cache_refresh_dead_letters
# Cache worker: dirty-key compensation cadence (seconds) and handler concurrency.
# The worker rebuilds affected Redis views from MySQL; a Redis write failure is
# recorded in cache_revisions and retried by this periodic pass, never nacked.
RAG_CACHE_WORKER_RECOVER_SECONDS=30
RAG_CACHE_WORKER_CONCURRENCY=1

# Upload tasks need a worker; MySQL is the single source of truth and the
# application never writes a transactional outbox (retired 2026-11-13):
#   * add_document and the default async REST/Console upload commit document_jobs
#     (complete state, including file bytes in MySQL) in a SINGLE transaction and
#     return only after that commit. File max 10 MiB, no chunking, no Redis task state.
#   * Two Debezium connectors tail the MySQL binlog and publish identifier-only
#     notifications; Kafka carries no file bytes, query text or KB settings:
#       - task connector: document_jobs -> RAG_DOCUMENT_TOPIC with
#         {"schema":4,"artifact_id","namespace","schedule_version"}.
#       - cache connector: the eight read-model tables -> RAG_CACHE_TOPIC as
#         locator-only before/after changes (consumed by rag-cache-worker).
#   * rag-document-worker / rag-cache-worker are the ONLY consumers of their
#     topics. They reload the authoritative row from MySQL and re-check
#     status/schedule_version, so a duplicate or stale notification is a no-op;
#     deletes and tombstones are ACKed without retry or dead letter.
#   * get_document_status reads MySQL directly. MCP/REST search is synchronous:
#     one call runs retrieval and returns evidence — there is no search task,
#     result_id, polling or result snapshot.
# Before upgrade stop the old stack and let both connectors snapshot the tables,
# then deploy the API and the two workers together: schema 4/schema 3
# notifications are incompatible with the old schema 3 chunked envelopes.
# Old outbox/result tables (including search_tasks/search_result_snapshots) may
# stay in the schema, but nothing writes or reads them on the active path; keep
# them only for historical rows.
# Compose Kafka auto-creates topics (4 partitions); start-stack.ps1 creates the
# known business + DLQ topics explicitly with kafka-topics.sh.
# POST /v1/document-batches admits files asynchronously and returns batch/item
# progress. Without Kafka + both connectors + the workers the jobs stay queued
# (rag-service still starts).
# Worker lease/heartbeat/recovery window for document jobs.
RAG_DOCUMENT_JOB_LEASE_SECONDS=300
RAG_DOCUMENT_JOB_HEARTBEAT_SECONDS=20
# 文档 Worker 运行心跳间隔（秒，写入 MySQL runtime_heartbeats，供 Console 监控页判断 Worker 是否真的在运行；60 秒无心跳判降级）
RAG_DOCUMENT_WORKER_HEARTBEAT_SECONDS=15
RAG_DOCUMENT_JOB_SWEEP_SECONDS=120
# Retention for finished document job rows (seconds). The outbox retention
# variable was removed together with the outbox tables; CDC record retention is
# controlled by the MySQL binlog expiry instead.
RAG_DOCUMENT_JOB_RETENTION_SECONDS=2592000
# Handler goroutines per rag-document-worker process (1..64; code default 1).
# This example runs four document tasks in one process. PDF parsing also needs
# matching capacity in RAG_PDF_SERVICE_CONCURRENCY below.
RAG_DOCUMENT_WORKER_CONCURRENCY=4
# Number of rag-document-worker processes scripts/start-stack.ps1 starts. Kafka
# shares the RAG_DOCUMENT_TOPIC partitions between consumers of the same group.
# Each process runs RAG_DOCUMENT_WORKER_CONCURRENCY handler goroutines; one
# process is enough for the four concurrent tasks configured above.
RAG_DOCUMENT_WORKERS=1

# --- Logging (rag-service + all workers + pdf-parser) -----------------------
# 统一结构化日志。RAG_LOG_LEVEL=debug|info|warning|error（默认 info；未设置时
# RAG_DEBUG_TRACE 为真则 debug）。RAG_LOG_FORMAT=text|json（默认 text）。
# 每个 HTTP 请求接受/回写 X-Request-ID；后台任务日志带 operation_id/artifact_id，
# 文档失败原因写入 document_jobs.error，重试耗尽/死信提示附最近一次失败摘要。
# RAG_LOG_LEVEL=info
# RAG_LOG_FORMAT=text
# RAG_DEBUG_TRACE=false
# 可选：把 rag-service 与 3 个 worker 的日志同时追加到同一个 JSON Lines 文件
# （含 time/level/msg/source/attrs），供 Console「系统监控」→「全部日志」的文件
# 日志源读取；目录必须已存在，打开失败会按配置错误启动失败。
# RAG_LOG_FILE=./dist/logs/praxis-rag.jsonl
# 可选：进程内日志环形缓冲条数（100..20000，默认 1000），供监控页内存日志源读取。
# RAG_LOG_BUFFER_SIZE=1000
# pdf-parser (Python) 使用同名语义的独立变量。
# RAG_PDF_SERVICE_LOG_LEVEL=info
# RAG_PDF_SERVICE_LOG_FORMAT=text

# --- Kafka Connect + Debezium MySQL connectors (started by Compose) ---------
# Two Debezium MySQL connectors run as tasks in a distributed Kafka Connect
# cluster (compose: connect-1/connect-2; production: at least two machines, the
# same pinned Debezium MySQL Connector version on every worker):
#   - praxis-document-cdc: document_jobs inserts and schedule_version updates
#     only; deletes are skipped.
#   - praxis-cache-cdc: the eight read-model tables, all c/u/d.
# Connector configs, source offsets (the binlog position) and task status live in
# Kafka internal topics, so a dead worker is replaced by its peer, which resumes
# from the saved position. Each connector has its own schema-history topic.
# MySQL must run binlog_format=ROW and binlog_row_image=FULL (compose enables
# both); each CDC account needs SELECT/RELOAD/SHOW DATABASES/REPLICATION
# SLAVE/REPLICATION CLIENT.
DEBEZIUM_CONNECT_IMAGE=quay.io/debezium/connect:3.7.1.Final
# Every worker must report this Debezium MySQL Connector version; registration
# refuses a mixed cluster.
DEBEZIUM_CONNECT_VERSION=3.7.1.Final
RAG_CONNECT_GROUP_ID=praxis-rag-connect
# Internal topics: connector configs, source offsets and task status.
RAG_CONNECT_CONFIG_TOPIC=praxis_connect_configs
RAG_CONNECT_OFFSET_TOPIC=praxis_connect_offsets
RAG_CONNECT_STATUS_TOPIC=praxis_connect_status
# 1 for the single-broker dev stack; use 2-3 in production.
RAG_CONNECT_TOPIC_REPLICATION_FACTOR=1
RAG_CONNECT_OFFSET_TOPIC_PARTITIONS=25
RAG_CONNECT_LOG_LEVEL=INFO
# Loopback REST ports of the two compose workers.
RAG_CONNECT_PORT_1=8083
RAG_CONNECT_PORT_2=8084
# Host processes (Console monitor + failed-task supervisor) probe this list; the
# compose app profile uses http://connect-1:8083,http://connect-2:8083 instead.
RAG_CONNECT_URLS=http://127.0.0.1:8083,http://127.0.0.1:8084
# Fixed connector names: registration, monitoring and restart supervision all
# address the two connectors by these names.
RAG_CONNECT_DOCUMENT_CONNECTOR=praxis-document-cdc
RAG_CONNECT_CACHE_CONNECTOR=praxis-cache-cdc
# Failed-task supervisor (Kafka Connect does not restart FAILED tasks itself):
# poll period, exponential backoff and a finite attempt budget. After the budget
# is exhausted the failure reason is logged and kept on the Console; no further
# restart is attempted until the task recovers or is changed.
RAG_CONNECT_SUPERVISOR_INTERVAL_SECONDS=15
# Optional: REST timeout (seconds, max 30) and supervisor on/off.
# RAG_CONNECT_TIMEOUT_SECONDS=3
# RAG_CONNECT_SUPERVISOR_ENABLED=true
RAG_CONNECT_RESTART_MAX_ATTEMPTS=5
RAG_CONNECT_RESTART_BASE_BACKOFF_SECONDS=2
RAG_CONNECT_RESTART_MAX_BACKOFF_SECONDS=300
# One MySQL CDC account per connector: a credential/privilege incident on one
# capture path must not stop the other (also used by the failed-task drill).
RAG_MYSQL_DEBEZIUM_USER=debezium
RAG_MYSQL_DEBEZIUM_PASSWORD=change-me-too
RAG_MYSQL_DEBEZIUM_CACHE_USER=debezium_cache
RAG_MYSQL_DEBEZIUM_CACHE_PASSWORD=change-me-too
# Distinct replication identity and schema-history topic per connector.
DEBEZIUM_SERVER_ID=184054
DEBEZIUM_CACHE_SERVER_ID=184055
RAG_CDC_DOCUMENT_SCHEMA_HISTORY_TOPIC=praxis_cdc_document_schema_history
RAG_CDC_CACHE_SCHEMA_HISTORY_TOPIC=praxis_cdc_cache_schema_history
# Container-internal schema-history bootstrap (connectors run inside Docker).
# RAG_CONNECT_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# 采集位点保存在 Kafka Connect 的 offset topic 中，应用读不到，因此监控页的
# “采集进度”始终显示“未知”；监控页显示两个命名连接器及其 task 状态、所在
# worker、失败原因、是否正在重启与恢复结果，下游 Kafka 消费积压单独显示。

# MCP `search` 与 REST POST /v1/search 都是同步执行：一次调用完成检索与重排并
# 直接返回证据，没有任务 ID、轮询、搜索 topic/group 或搜索 worker。
# RAG_SEARCH_TIMEOUT_SECONDS 是同步检索的总预算（秒）：超时按既有搜索错误语义返回
# 503；客户端断开/请求取消会向下传递到 Qdrant 与模型调用。
RAG_SEARCH_TIMEOUT_SECONDS=120
# Optional worker retry overrides (in-process retries, not broker resources).
# The durable document execution budget is document_jobs.attempts (max 3);
# these values only bound Kafka redeliveries of one notification.
# RAG_DOCUMENT_MAX_ATTEMPTS=3
# Independent DLQ handler: rag-dead-letter-worker --kind document|cache.
# It consumes RAG_*_DLQ_TOPIC with RAG_*_DLQ_GROUP and ACKs only after the durable
# terminal state is written; transient failures are not ACKed.

# RAG_RESULT_TTL_SECONDS is the ARTIFACT TTL (not a search result snapshot TTL):
# version-bound artifact rows in MySQL artifact_snapshots survive document
# updates/deletion until this TTL expires; GET /v1/artifacts/{id} reads them
# directly. Search responses are not stored at all — the synchronous response is
# the only copy, and its evidence artifact references stay readable through the
# artifact endpoints. RAG_ARTIFACT_MAX_BYTES bounds one artifact read and
# RAG_RESULT_MAX_ARTIFACTS bounds how many artifacts one search response carries.
# Legacy note: RAG_RESULT_MAX_BYTES is no longer read; the startup config treats it
# as an ignored legacy key (kept only so an old .env/config.toml does not fail).
# Result TTL is independent of the 60-second persistent read-model cache TTL above.
# KB/API keys/catalog and the publication journal remain MySQL.
RAG_RESULT_TTL_SECONDS=3600
RAG_ARTIFACT_MAX_BYTES=67108864
RAG_RESULT_MAX_ARTIFACTS=100

# --- Word settings and the shared VLM endpoint ------------------------------
# DOCX parsing runs in-process in Go; no parser environment is required.
# Word pictures without a caption are described through a remote
# OpenAI-compatible VLM (the Console knowledge-base VLM settings page takes
# precedence; these variables are the fallback). Without an endpoint the
# pictures keep a placeholder description and the upload still succeeds.
# The same endpoint is used by pdf-parser for PDF layout/OCR/tables/formulas/
# picture descriptions (see the PDF section below); there is no local model
# fallback. LibreOffice is only needed to convert legacy .doc files.
# RAG_WORD_CONVERTER_PATH=C:/Program Files/LibreOffice/program/soffice.exe
# RAG_WORD_CONVERT_TIMEOUT=120
# RAG_VLM_BASE_URL=https://llm.internal/v1
# RAG_VLM_API_KEY=change-me
# RAG_VLM_MODEL=qwen2.5-vl-7b
# RAG_VLM_TIMEOUT=120
# RAG_VLM_CONCURRENCY=4

# --- PDF parsing (remote vision microservice) -------------------------------
# The Go service can parse PDFs itself (text-only) or delegate to a separate
# PDF vision microservice that reads/renders/crops with PyMuPDF and calls a
# remote OpenAI-compatible vision model for layout, OCR, tables, formulas and
# picture descriptions. The Go image never contains Python; pdf-parser is its
# own image/service on :8091 and loads no local models.
#   go      = always use the in-process Go text engine (no external service)
#   vision  = always call RAG_PDF_SERVICE_URL (PDF upload fails if it is down)
#   empty   = vision when RAG_PDF_SERVICE_URL is set, otherwise go
# "docling" is accepted as a legacy alias for "vision".
# Under vision, each knowledge base must also select a VLM in the Console
# (Model Profiles, then the knowledge-base form); otherwise PDF uploads are
# rejected with a configuration reminder before any queue work. OCR is part of
# the vision model; there is no separate OCR engine. RAG_VLM_* below remains an
# environment fallback.
# Compose injects vision + http://pdf-parser:8091 into the app container, and
# `docker compose up -d` starts pdf-parser by default (no profile).
RAG_PDF_ENGINE=vision
# pdf-parser base URL for Go processes that run on the host. The built-in
# default is http://127.0.0.1:8091. Leave this unset here so the compose app
# container keeps its own container-internal http://pdf-parser:8091.
# RAG_PDF_SERVICE_URL=http://127.0.0.1:8091
# Total HTTP budget for one PDF parse call (seconds, 1..7200), also the Go
# client timeout. pdf-parser spends at most (this - PARSE_TIMEOUT) waiting for
# a conversion slot (503 when that expires); queueing does not consume the parse
# window below.
RAG_PDF_SERVICE_TIMEOUT=900
# Actual conversion budget once a slot has been acquired (seconds, default 120,
# must be smaller than RAG_PDF_SERVICE_TIMEOUT). It starts when the conversion
# thread starts, so a queued request still gets the full window. Expiry returns
# 504 and the timed-out thread keeps its slot until it stops; a retry of the
# same PDF waits for that previous thread.
RAG_PDF_SERVICE_PARSE_TIMEOUT=120
# pdf-parser image name and published loopback port. The container port is
# always 8091; changing the host port also requires updating
# RAG_PDF_SERVICE_URL for host-run Go services.
# RAG_PDF_PARSER_IMAGE=praxis-rag-pdf-parser:local
RAG_PDF_SERVICE_PORT=8091
# PDF service process count inside one container (Uvicorn workers, default 1).
# All processes share port 8091; no additional service URLs are needed.
# Each process has its own CONCURRENCY conversion slots (no model memory).
RAG_PDF_SERVICE_WORKERS=1
# Concurrent PDF conversions per pdf-parser process (code default 1).
# This example permits four conversions via an asyncio semaphore; each conversion
# runs in a background thread. Size for the container's available CPU/memory and
# the remote vision endpoint's rate limits.
# PDF capacity = SERVICE_WORKERS * SERVICE_CONCURRENCY. Compare this with
# document task concurrency = DOCUMENT_WORKERS * DOCUMENT_WORKER_CONCURRENCY.
RAG_PDF_SERVICE_CONCURRENCY=4
# Test-only converter switch for pdf-parser: "fake" returns a fixed manifest
# without calling the vision model. Never set this in production.
# RAG_PDF_SERVICE_CONVERTER=fake

# --- Go backend ------------------------------------------------------------
# The Go container binds 0.0.0.0 and therefore REQUIRES a service token and the MCP
# allowlists. These values are only read by the Go service and the optional compose
# "app" profile; the default `docker compose up` still starts infrastructure only.
# RAG_SERVICE_TOKEN=change-me
# Console accounts. Login is enabled by default: the first registered account
# becomes the administrator. Set RAG_AUTH_REGISTRATION=closed to disable
# self-service registration (an admin still has to exist first).
# RAG_AUTH_ENABLED=true
# RAG_AUTH_REGISTRATION=open
# RAG_AUTH_SESSION_TTL_HOURS=168
# Set to true when the Console is served over HTTPS.
# RAG_AUTH_COOKIE_SECURE=false
# Knowledge-base sharing. Roles are admin / vip / user; only administrators can
# change them. A knowledge base is private to its creator and is shared through
# time-limited invite links (read-only or read/write, whole KB or selected files).
# RAG_INVITATION_TTL_HOURS=168
# VIPs and normal users create their own knowledge base by cloning the model
# connections of this template knowledge base (create it as an administrator
# first; self-create answers 409 while the template is missing).
# RAG_DEFAULT_KB_TEMPLATE=default
# RAG_APP_IMAGE=praxis-rag:local
# RAG_APP_PORT=8011
# RAG_APP_QDRANT_URL=http://qdrant:6333
# RAG_MCP_ALLOWED_HOSTS=127.0.0.1,localhost
# RAG_MCP_ALLOWED_ORIGINS=http://127.0.0.1,http://localhost
