# Copy to .env and fill in real values. Never commit .env.
RAG_MYSQL_HOST=127.0.0.1
RAG_MYSQL_PORT=3307
RAG_MYSQL_USER=rag
RAG_MYSQL_DATABASE=praxis_rag
RAG_MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# 32-byte base64 key, for example:
# python -c "import base64,secrets;print('base64:'+base64.b64encode(secrets.token_bytes(32)).decode())"
RAG_STATE_ENCRYPTION_KEY=base64:replace-with-32-byte-key

QDRANT_URL=http://127.0.0.1:6333

# First-batch state cache and reliable failed-refresh delivery (optional).
RAG_REDIS_URL=redis://127.0.0.1:6379/0
RAG_REDIS_PREFIX=rag:state:v1
RAG_REDIS_TTL_SECONDS=60
RAG_REDIS_TIMEOUT_SECONDS=0.3
# Shared RocketMQ connection for cache refresh and asynchronous MCP documents.
RAG_ROCKETMQ_ENDPOINT=127.0.0.1:8081
# Cache refresh topic/group (unchanged).
RAG_ROCKETMQ_TOPIC=praxis_state_cache_refresh
RAG_ROCKETMQ_GROUP=praxis_state_cache_refresh_workers
# Optional shared namespace, TLS and credentials; set secrets only in the environment/.env.
RAG_ROCKETMQ_NAMESPACE=
RAG_ROCKETMQ_TLS=false
RAG_ROCKETMQ_ACCESS_KEY=
RAG_ROCKETMQ_SECRET_KEY=

# Asynchronous MCP add_document requires the [cache] SDK and a separate worker.
# API runs only an outbox relay, never a document consumer.
# Provision both topic/group pairs: broker auto-creation is disabled.
RAG_DOCUMENT_TOPIC=praxis_document_ingest
RAG_DOCUMENT_GROUP=praxis_document_ingest_workers
RAG_DOCUMENT_MAX_ATTEMPTS=3
RAG_DOCUMENT_LEASE_SECONDS=120
RAG_DOCUMENT_RETRY_SECONDS=10
# Worker shares API MySQL, QDRANT_URL and RAG_STATE_ENCRYPTION_KEY settings above.
# Uploaded bytes persist in MySQL without an upload TTL.

# Redis-only search results; old referenced artifacts survive updates/deletion.
RAG_RESULT_TTL_SECONDS=3600
RAG_RESULT_MAX_BYTES=16777216
RAG_ARTIFACT_MAX_BYTES=67108864
RAG_RESULT_MAX_ARTIFACTS=100
