# Copy to .env and fill in real values. Never commit .env.
RAG_MYSQL_HOST=127.0.0.1
RAG_MYSQL_PORT=3307
RAG_MYSQL_USER=rag
RAG_MYSQL_DATABASE=praxis_rag
RAG_MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# 32-byte base64 key, for example:
# python -c "import base64,secrets;print('base64:'+base64.b64encode(secrets.token_bytes(32)).decode())"
RAG_STATE_ENCRYPTION_KEY=base64:replace-with-32-byte-key

QDRANT_URL=http://127.0.0.1:6333

# Redis is REQUIRED for MCP upload/search task state, document reassembly and
# search result snapshots. Persistent MySQL read-model caching is a separate role.
# Missing/unreachable Redis or MQ prevents queued acceptance; no SQL fallback.
RAG_REDIS_URL=redis://127.0.0.1:6379/0
RAG_REDIS_PREFIX=rag:state:v1
RAG_REDIS_TTL_SECONDS=60
RAG_REDIS_TIMEOUT_SECONDS=0.3
# Shared RocketMQ connection for cache refresh and asynchronous MCP documents/search.
RAG_ROCKETMQ_ENDPOINT=127.0.0.1:8081
# Cache refresh topic/group (unchanged).
RAG_ROCKETMQ_TOPIC=praxis_state_cache_refresh
RAG_ROCKETMQ_GROUP=praxis_state_cache_refresh_workers
# Optional shared namespace, TLS and credentials; set secrets only in the environment/.env.
# Verify SDK/Proxy namespace mapping before use; metadata alone is not physical isolation.
RAG_ROCKETMQ_NAMESPACE=
RAG_ROCKETMQ_TLS=false
RAG_ROCKETMQ_ACCESS_KEY=
RAG_ROCKETMQ_SECRET_KEY=

# MCP upload/search require the [cache] SDK and separate document/search workers.
# API sends schema 2 full-request envelopes and returns success only after ALL
# messages are broker-confirmed and Redis acceptance state is written.
# Documents use <=512 KiB decoded chunks; file max 10 MiB.
# API does not run document/search consumers or SQL task/outbox relays.
# Before upgrade drain old workers/outboxes/messages, then deploy API/workers together:
# schema 2 is incompatible with UUID-only messages; old jobs/results are not migrated.
# Keep legacy SQL task/outbox/result tables, but do not use them on the active path.
# Provision normal topic/groups and DLQ reader resources: broker auto-creation is disabled.
RAG_DOCUMENT_TOPIC=praxis_document_ingest
RAG_DOCUMENT_GROUP=praxis_document_ingest_workers
# Provisioning script only: Broker owns consumption retries, invisibility and DLQ.
RAG_DOCUMENT_BROKER_MAX_RETRIES=16
# Separate handler group; actual normal Broker DLQ topic is %DLQ%<source consumer group>.
RAG_DOCUMENT_DLQ_GROUP=praxis_document_dead_letters
# Document worker --dispatch-only is removed. Legacy RAG_DOCUMENT_DISPATCH_*,
# RAG_DOCUMENT_MAX_ATTEMPTS/LEASE_SECONDS/RETRY_SECONDS are ignored (including
# old config.toml entries); remove them. Broker retry policy uses the setting above.
# Dispatcher compatibility entry points do not relay SQL (no filesystem MQ spool).
# Incomplete document chunks are NEVER ACKed; replay can rebuild lost Redis data.
# After completing execution and recording terminal state, duplicates can be ACKed.
# Task/reassembly TTL uses RAG_RESULT_TTL_SECONDS (default 3600), as do results.
# Worker shares API MySQL, Redis, QDRANT_URL and state encryption settings above.
# Permanent published blobs/artifacts and UploadJournal operations/leases stay MySQL.
# Redis loss/TTL can invalidate transient upload IDs/reassembly; resubmit if needed.
# Document success is recorded after durable publication, reconciled via journal on retry;
# there is no atomic Redis+MySQL transaction. Log only IDs and safe error categories.

# Service MCP search requires a separate rag-search-worker consumer.
# Existing installations must start it or searches remain queued until the task deadline.
# Shares API MySQL, Redis, RocketMQ, Qdrant and state encryption settings.
# Each worker executes sequentially; search and document queues remain independent.
RAG_SEARCH_TOPIC=praxis_search
RAG_SEARCH_GROUP=praxis_search_workers
# Task deadline includes queue waiting; MCP wait_seconds (default 10, range 0..30) is not a deadline.
RAG_SEARCH_TIMEOUT_SECONDS=120
# Provisioning script only; not runtime Python retry configuration.
RAG_SEARCH_BROKER_MAX_RETRIES=16
RAG_SEARCH_DLQ_GROUP=praxis_search_dead_letters
# Planned independent DLQ handler: rag-dead-letter-worker --kind document|search.
# Write deterministic failure to Redis before ACK; transient failures are not ACKed.
# No model/inference; normal DLQ receive+ACK verified with SDK 5.1.2 / Apache Broker 5.3.3.
# Revalidate other SDK/Proxy/Broker deployments and namespace mapping before rollout.

# Search result snapshots live ONLY in Redis; loss/TTL means unavailable, no SQL fallback.
# Result TTL is independent of the 60-second persistent read-model cache TTL above.
# Version-bound MySQL artifact snapshots (not search results) survive document
# updates/deletion until expiry. KB/API keys/catalog and publication journal remain MySQL.
RAG_RESULT_TTL_SECONDS=3600
RAG_RESULT_MAX_BYTES=16777216
RAG_ARTIFACT_MAX_BYTES=67108864
RAG_RESULT_MAX_ARTIFACTS=100
