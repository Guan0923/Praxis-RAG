# Build context exclusions for the Praxis-RAG Go service image.
# The frontend is built in its own stage from frontend/, so the Python backend,
# tests, docs and local caches/data never need to enter the context.

# Version control / agent metadata
.git
.gitignore
.gitattributes
.dsh-project-memory
.vscode
.agents

# Python backend, tests and Python packaging (kept out of the Go image)
src
tests
benchmarks
examples
docs
pyproject.toml
uv.lock
PROGRESS.md
VALIDATION.md

# Local caches, virtualenvs and generated data
.venv
venv
__pycache__
*.py[cod]
.pytest_cache
.ruff_cache
.mypy_cache
.test-tmp
models
model-cache
qdrant_storage
.mini_agent-rag

# Node/Go build outputs and dependencies
frontend/node_modules
frontend/*.tsbuildinfo
dist
bin
*.exe

# Local environment and logs (never bake secrets into the image)
.env
.env.*
*.log
